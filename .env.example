# ============================================================
# SmartCampus AI - Variables d'environnement (exemple)
# Copier ce fichier puis adapter les valeurs :
#   cp .env.example .env
# Ne jamais committer le fichier .env (secrets).
# ============================================================

# --- Application ---
PROJECT_NAME=SmartCampus AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Origines autorisées pour CORS (liste séparée par des virgules)
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Base de données PostgreSQL (+ pgvector) ---
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus
POSTGRES_DB=smartcampus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# URL de connexion utilisée par le backend.
# En Docker, remplacer "localhost" par le nom du service "db".
DATABASE_URL=postgresql+psycopg://smartcampus:smartcampus@localhost:5432/smartcampus

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- pgAdmin ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@smartcampus.tn
PGADMIN_DEFAULT_PASSWORD=admin

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
