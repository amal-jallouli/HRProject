# ============================================================
# SmartCampus AI - Variables d'environnement (exemple)
# Copier ce fichier puis adapter les valeurs :
#   cp .env.example .env
# Ne jamais committer le fichier .env (secrets).
# ============================================================

# --- Application ---
PROJECT_NAME=SmartCampus AI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Origines autorisées pour CORS (liste séparée par des virgules)
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Base de données PostgreSQL (+ pgvector) ---
# Compte administrateur (superuser) : réservé à l'administration (pgAdmin, make db-shell)
POSTGRES_USER=smartcampus
POSTGRES_PASSWORD=smartcampus
POSTGRES_DB=smartcampus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Compte applicatif à droits limités : utilisé par FastAPI et Alembic
APP_DB_USER=smartcampus_app
APP_DB_PASSWORD=smartcampus_app
# URL de connexion utilisée par le backend (compte applicatif, pas l'admin).
# En Docker, remplacer "localhost" par le nom du service "db".
DATABASE_URL=postgresql+psycopg://smartcampus_app:smartcampus_app@localhost:5432/smartcampus


# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# --- Sessions visiteurs (SA-25) ---
VISITOR_SESSION_TTL_MINUTES=60
VISITOR_RATE_LIMIT_PER_MINUTE=30
VISITOR_MAX_MESSAGES_PER_SESSION=50
VISITOR_MAX_SESSIONS_PER_IP_PER_HOUR=10
# --- Mémoire temporaire des conversations (SA-26) ---
VISITOR_MEMORY_MAX_MESSAGES=20
VISITOR_MESSAGE_MAX_LENGTH=2000
# --- pgAdmin ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@smartcampus.tn
PGADMIN_DEFAULT_PASSWORD=admin

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
